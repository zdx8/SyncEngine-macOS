# macOS
.DS_Store

# SwiftPM / Xcode
# 不带前导斜杠的模式匹配任意层级，因此这两条同时覆盖 SyncApp/ 下的同名目录。
.build/
.swiftpm/
xcuserdata/
*.xcodeproj
DerivedData/

# 构建与打包产物（可由 Scripts/ 下的脚本重建，不入库）
dist/
SyncApp/Resources/AppIcon.icns

# 开发过程记录（本机工作记忆，含环境细节，不公开）
.workbuddy/

# 本地验证截图证据（官网用的图已单独放在 website/screenshots/）
截图/

# 日志与临时文件
*.log
*.tmp
